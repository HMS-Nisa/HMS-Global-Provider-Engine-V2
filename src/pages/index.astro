            </div>

        <div id="loadMoreContainer" class="hidden flex justify-center pb-8">
            <button id="loadMoreBtn" class="group relative inline-flex items-center justify-center px-8 py-3.5 bg-white border border-slate-200 rounded-full hover:border-[#127289] hover:shadow-lg transition-all duration-300">
                <span class="text-sm font-bold text-slate-600 uppercase tracking-widest group-hover:text-[#127289] mr-3">Load More Facilities</span>
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-50 group-hover:bg-[#127289]/10 group-hover:text-[#127289] transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
            </button>
        </div>

		<div id="emptyState" class="hidden flex flex-col items-center justify-center py-24 text-center opacity-0 transition-opacity duration-500" style="opacity: 1;">
			<div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-6 shadow-sm border border-slate-100">
				<svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
			</div>
			<h3 class="text-lg font-bold text-slate-900 mb-2">No facilities found</h3>
			<p class="text-slate-500 text-sm max-w-xs mx-auto">Try adjusting your filters or search terms.</p>
		</div>
	</main>

	<footer class="bg-white border-t border-slate-100 py-12 mt-auto">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
			<div class="flex items-center gap-3 opacity-60 hover:opacity-100 transition-opacity">
				<img src="/logo.png" alt="HealthMetrics Logo" class="h-6 w-auto object-contain grayscale hover:grayscale-0 transition-all" />
			</div>
			<div class="text-xs font-medium text-slate-400 tracking-wide">
				© <span id="year"></span> HealthMetrics Sdn Bhd.
			</div>
		</div>
	</footer>

    <script define:vars={{ initialData }}>
        window.SERVER_DATA = JSON.parse(initialData);
    </script>

</Layout>

<script>
	// -- DOM ELEMENTS --
	const yearEl = document.getElementById('year');
	if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

	const countrySelect = document.getElementById('countrySelect') as HTMLSelectElement;
	const provinceSelect = document.getElementById('provinceSelect') as HTMLSelectElement;
	const citySelect = document.getElementById('citySelect') as HTMLSelectElement;
	const serviceTypeSelect = document.getElementById('serviceTypeSelect') as HTMLSelectElement;
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const resultsGrid = document.getElementById('resultsGrid');
	const emptyState = document.getElementById('emptyState');
	const countLabel = document.getElementById('count');
	const resetBtn = document.getElementById('resetBtn');
    
    // New Load More Elements
    const loadMoreContainer = document.getElementById('loadMoreContainer');
    const loadMoreBtn = document.getElementById('loadMoreBtn');

	// -- STATE --
	let allFacilities = (window as any).SERVER_DATA || [];
	let filteredFacilities: any[] = [];

    // Pagination State
    let visibleLimit = 50;
    const BATCH_SIZE = 50;

	// -- ANALYTICS --
	// Everything on this site happens on a single URL, so these events are the
	// only signal of what people actually look for.
	// gtag() sends to GA4; the dataLayer push keeps the same events available to
	// a GTM container. Both are initialised in Layout.astro, so this is a safe
	// no-op when no analytics ID is configured.
	function track(event: string, payload: Record<string, any> = {}) {
		const w = window as any;
		w.gtag?.('event', event, payload);
		(w.dataLayer ||= []).push({ event, ...payload });
	}

	let searchTimer: ReturnType<typeof setTimeout>;
	function trackSearchDebounced(term: string, resultCount: number) {
		clearTimeout(searchTimer);
		if (!term) return;
		searchTimer = setTimeout(() => {
			track('directory_search', { search_term: term, result_count: resultCount });
		}, 800);
	}

	// -- INIT --
	function applyFilters() {
		const country = countrySelect.value;
		const province = provinceSelect.value;
		const city = citySelect.value;
		const serviceType = serviceTypeSelect.value;
		const keyword = searchInput.value.toLowerCase().trim();

		filteredFacilities = allFacilities.filter((item: any) => {
			const matchesGeo = (!country || item.country === country) &&
							   (!province || item.province === province) &&
							   (!city || item.city === city);

			const matchesType = !serviceType || item.serviceType === serviceType;

			const matchesKeyword = !keyword ||
								   item.name.toLowerCase().includes(keyword) ||
								   item.address.toLowerCase().includes(keyword) ||
								   item.city?.toLowerCase().includes(keyword);

			return matchesGeo && matchesType && matchesKeyword;
		});
	}

	function init() {
		applyFilters();
		updateDropdownOptions('init');
		renderGrid();
	}

	// -- SMART FILTER LOGIC --
	function getUniqueFromList(list: any[], key: string) {
		return [...new Set(list.map(f => f[key]).filter(Boolean))].sort();
	}

	function populateDropdown(select: HTMLSelectElement, items: any[], defaultText: string) {
		const currentVal = select.value;
		select.innerHTML = `<option value="">${defaultText}</option>`;
		items.forEach(item => {
			const option = document.createElement('option');
			option.value = item;
			option.textContent = item;
			select.appendChild(option);
		});
		if (items.includes(currentVal)) {
			select.value = currentVal;
		} else {
			select.value = "";
		}
	}

	function updateDropdownOptions(source: 'init' | 'country' | 'city') {
		const selectedCountry = countrySelect.value;
		const selectedCity = citySelect.value;

		if (source === 'init') {
			populateDropdown(countrySelect, getUniqueFromList(allFacilities, 'country'), "All Countries");
		}

        // Hierarchy Logic:
        // 1. If NO country is selected, disable City and Province
		if (!selectedCountry) {
            citySelect.disabled = true;
            citySelect.innerHTML = `<option value="">Select a Country first</option>`;
            citySelect.classList.add('bg-slate-50');
            citySelect.classList.remove('bg-white');
            
            provinceSelect.disabled = true;
            provinceSelect.innerHTML = `<option value="">Select a City first</option>`;
            provinceSelect.classList.add('bg-slate-50');
            provinceSelect.classList.remove('bg-white');
        } else {
            // Country IS selected, enable City and populate it if triggered by country change or init
            if (source === 'country' || source === 'init') {
                citySelect.disabled = false;
                citySelect.classList.remove('bg-slate-50');
                citySelect.classList.add('bg-white');

                const facilitiesInCountry = allFacilities.filter(f => f.country === selectedCountry);
                const validCities = getUniqueFromList(facilitiesInCountry, 'city');
                populateDropdown(citySelect, validCities, "All Cities");
            }

            // If a country is selected but no city, disable province
            if (!citySelect.value) {
                provinceSelect.disabled = true;
                provinceSelect.innerHTML = `<option value="">Select a City first</option>`;
                provinceSelect.classList.add('bg-slate-50');
                provinceSelect.classList.remove('bg-white');
            } else {
                // City IS selected, enable Province and populate it
                provinceSelect.disabled = false;
                provinceSelect.classList.remove('bg-slate-50');
                provinceSelect.classList.add('bg-white');

                const facilitiesForProvinces = allFacilities.filter(f => f.country === selectedCountry && f.city === citySelect.value);
                const validProvinces = getUniqueFromList(facilitiesForProvinces, 'province');
                populateDropdown(provinceSelect, validProvinces, "All Provinces");
            }
        }
	}

	function handleFilterChange(e: Event) {
		const target = e.target as HTMLSelectElement;
		const sourceId = target.id;

		if (sourceId === 'countrySelect') {
			citySelect.value = "";
			provinceSelect.value = "";
			updateDropdownOptions('country');
		} else if (sourceId === 'citySelect') {
			provinceSelect.value = "";
			updateDropdownOptions('city');
		}

		applyFilters();

        // Reset pagination when filters change
        visibleLimit = BATCH_SIZE;
		renderGrid();

		const country = countrySelect.value;
		const province = provinceSelect.value;
		const city = citySelect.value;
		const serviceType = serviceTypeSelect.value;
		const keyword = searchInput.value.toLowerCase().trim();

		if (sourceId === 'searchInput') {
			trackSearchDebounced(keyword, filteredFacilities.length);
		} else {
			track('directory_filter', {
				filter_name: sourceId.replace('Select', ''),
				filter_value: target.value || '(all)',
				result_count: filteredFacilities.length,
				active_country: country || '(all)',
				active_city: city || '(all)',
				active_province: province || '(all)',
				active_service_type: serviceType || '(all)',
			});
		}
	}

	function renderGrid() {
		if(!resultsGrid || !countLabel || !emptyState || !loadMoreContainer) return;

		resultsGrid.innerHTML = '';
		countLabel.textContent = filteredFacilities.length.toString();

		if (filteredFacilities.length === 0) {
			emptyState.classList.remove('hidden');
			emptyState.style.opacity = '1';
            loadMoreContainer.classList.add('hidden');
			return;
		} else {
			emptyState.classList.add('hidden');
		}

        // --- LOAD MORE LOGIC ---
        // Determine if we need to show the button
        if (visibleLimit >= filteredFacilities.length) {
            loadMoreContainer.classList.add('hidden');
        } else {
            loadMoreContainer.classList.remove('hidden');
        }

        // Slice data based on visibleLimit
		filteredFacilities.slice(0, visibleLimit).forEach((facility, index) => {
			const card = document.createElement('article');
			
			const delay = index < 15 ? index * 50 : 0;
			card.style.animationDelay = `${delay}ms`;
			card.className = "animate-card opacity-0 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.02)] hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 border border-slate-200/60 flex flex-col h-full group cursor-default hover:border-[#127289]/50 hover:ring-2 hover:ring-[#127289]/10";
			
			const brandColor = '#127289';
			const topBorderColor = `bg-[${brandColor}]`;

			const typeBadgeStyles: Record<string, {bg: string; color: string}> = {
				'GP':         { bg: '#EFF6FF', color: '#1D4ED8' },
				'Hospital':   { bg: '#FFF7ED', color: '#C2410C' },
				'Dental':     { bg: '#F5F3FF', color: '#7C3AED' },
				'Specialist': { bg: '#ECFDF5', color: '#059669' },
				'Other':      { bg: '#F8FAFC', color: '#64748B' },
			};
			const badge = typeBadgeStyles[facility.serviceType] || typeBadgeStyles['Other'];
			const displayPhone = facility.phone ? facility.phone : null;
			const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
			const rawAddress = facility.address ? facility.address.replace(/[\s,]+$/, '').trim() : '';
			const displayAddress = rawAddress ? escapeHtml(rawAddress) : null;
			const mapQuery = encodeURIComponent([facility.name, rawAddress, facility.city].filter(Boolean).join(', '));

			card.innerHTML = `
				<div class="h-1 w-full ${topBorderColor} opacity-90 group-hover:h-1.5 transition-all duration-300"></div>

				<div class="p-6 flex flex-col h-full relative z-10">
					<div class="flex justify-between items-center mb-4">
						<span style="background:${badge.bg};color:${badge.color}" class="px-2.5 py-1 text-[10px] font-bold rounded-full uppercase tracking-wider leading-none">${facility.serviceType}</span>
						<div class="flex items-center gap-1.5" title="Direct Contract">
							<span class="relative flex h-1.5 w-1.5">
							  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
							  <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500"></span>
							</span>
						</div>
					</div>
					
					<h3 class="text-[17px] font-semibold text-slate-800 mb-4 leading-snug tracking-tight group-hover:text-[#127289] transition-colors">${facility.name}</h3>
					
					<div class="space-y-2.5 mb-6">
						${displayAddress ? `
						<div class="flex items-start gap-3">
							<div class="text-slate-300 group-hover:text-[#127289] transition-colors mt-0.5 shrink-0">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
							</div>
							<p class="text-[13px] text-slate-500 font-medium leading-relaxed">${displayAddress}</p>
						</div>` : `
						<div class="flex items-start gap-3">
							<div class="text-slate-300 group-hover:text-[#127289] transition-colors mt-0.5 shrink-0">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
							</div>
							<p class="text-[13px] text-slate-400 italic font-medium leading-relaxed">Address not listed — tap Map for location &amp; directions</p>
						</div>`}
						${displayPhone ? `
						<div class="flex items-center gap-3">
							<div class="text-slate-300 group-hover:text-[#127289] transition-colors shrink-0">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
							</div>
							<p class="text-[13px] text-slate-500 font-medium tracking-wide">${displayPhone}</p>
						</div>` : ''}
					</div>
					
					<div class="mt-auto pt-4 border-t border-slate-50 flex items-center justify-between">
						<div class="flex flex-col">
							<span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Location</span>
							<span class="text-[11px] font-bold text-slate-700 group-hover:text-[#127289] transition-colors">${facility.city}, ${facility.province}</span>
						</div>
						<a href="https://www.google.com/maps/search/?api=1&query=${mapQuery}" target="_blank" rel="noopener noreferrer" data-map-link data-provider="${facility.name}" data-city="${facility.city}" data-country="${facility.country}" data-service-type="${facility.serviceType}" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 text-[#127289] hover:bg-[#127289] hover:text-white transition-all duration-300 border border-slate-100 hover:border-[#127289] shadow-sm group/btn" title="View on Map">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
							<span class="text-[10px] font-bold uppercase tracking-wider">Map</span>
						</a>
					</div>
				</div>
			`;
			resultsGrid.appendChild(card);
		});
	}

	// -- EVENTS --
	countrySelect.addEventListener('change', handleFilterChange);
	provinceSelect.addEventListener('change', handleFilterChange);
	citySelect.addEventListener('change', handleFilterChange);
	serviceTypeSelect.addEventListener('change', handleFilterChange);
	searchInput.addEventListener('input', handleFilterChange);

    // Load More Event
    if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', () => {
            visibleLimit += BATCH_SIZE;
            renderGrid();
            track('directory_load_more', {
                visible_count: Math.min(visibleLimit, filteredFacilities.length),
                result_count: filteredFacilities.length,
            });
        });
    }

    // Cards are re-rendered on every filter change, so delegate.
    if (resultsGrid) {
        resultsGrid.addEventListener('click', (e) => {
            const link = (e.target as HTMLElement).closest('[data-map-link]') as HTMLElement | null;
            if (!link) return;
            track('provider_map_click', {
                provider_name: link.dataset.provider,
                provider_city: link.dataset.city,
                provider_country: link.dataset.country,
                provider_service_type: link.dataset.serviceType,
            });
        });
    }

    document.getElementById('mainSiteLink')?.addEventListener('click', () => {
        track('outbound_click', { link_url: 'https://healthmetrics.com', link_text: 'Visit Main Site' });
    });

	resetBtn.addEventListener('click', () => {
		countrySelect.value = "";
		provinceSelect.value = "";
		citySelect.value = "";
		serviceTypeSelect.value = "";
		searchInput.value = "";
		
		updateDropdownOptions('init');

		applyFilters();

        // Reset pagination
        visibleLimit = BATCH_SIZE;
		renderGrid();
		track('directory_reset', { result_count: filteredFacilities.length });
	});

	init()
</script>
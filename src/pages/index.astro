---
import Layout from '../layouts/Layout.astro';
import providers from '../data/providers.json';

// --- PROVIDER DATA ---
// The directory lives in src/data/providers.json, committed alongside the code.
// The JSON is the master: fields are already normalised (clean title-cased
// names, canonical serviceType), so the build uses them as-is. Add or remove
// providers with `npm run provider -- add|remove`, or refresh from the Google
// Sheet with `npm run sync-data`; either way the JSON diff is reviewable in
// the commit.
const allFacilities = providers.map((p) => ({ ...p, phone: '' }));

const initialData = JSON.stringify(allFacilities);

const PAGE_TITLE = 'HealthMetrics - Direct Contract Facility Directory';
const PAGE_DESCRIPTION =
	'Search the HealthMetrics global network of direct contract hospitals, GPs, dental and specialist clinics. Filter by country, city, province and service type.';

// --- STRUCTURED DATA ---
// The full directory is thousands of rows; embedding all of them would bloat the
// HTML for no search benefit. ItemList does not have to be exhaustive, so we
// publish a sample and declare the true total via numberOfItems.
const SCHEMA_SAMPLE_SIZE = 50;

const SERVICE_TYPE_SCHEMA: Record<string, string> = {
	Hospital: 'Hospital',
	GP: 'MedicalClinic',
	Dental: 'Dentist',
	Specialist: 'MedicalClinic',
	Other: 'MedicalOrganization',
};

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			name: 'HealthMetrics Sdn Bhd',
			url: 'https://healthmetrics.com',
			...(Astro.site ? { logo: new URL('/logo.png', Astro.site).href } : {}),
		},
		{
			'@type': 'CollectionPage',
			name: PAGE_TITLE,
			description: PAGE_DESCRIPTION,
			...(Astro.site ? { url: new URL('/', Astro.site).href } : {}),
			mainEntity: {
				'@type': 'ItemList',
				name: 'Direct contract facilities',
				numberOfItems: allFacilities.length,
				itemListElement: allFacilities
					.slice(0, SCHEMA_SAMPLE_SIZE)
					.map((facility: any, index: number) => ({
						'@type': 'ListItem',
						position: index + 1,
						item: {
							'@type': SERVICE_TYPE_SCHEMA[facility.serviceType] || 'MedicalOrganization',
							name: facility.name,
							...(facility.phone ? { telephone: facility.phone } : {}),
							address: {
								'@type': 'PostalAddress',
								...(facility.address ? { streetAddress: facility.address } : {}),
								...(facility.city ? { addressLocality: facility.city } : {}),
								...(facility.province ? { addressRegion: facility.province } : {}),
								...(facility.country ? { addressCountry: facility.country } : {}),
							},
						},
					})),
			},
		},
	],
};
---

<Layout title={PAGE_TITLE} description={PAGE_DESCRIPTION}>

	<script
		slot="head"
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(jsonLd)}
	/>

	<style is:global>
		/* Enforce Inter font features */
		body {
			font-family: 'Inter', system-ui, -apple-system, sans-serif;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
			font-feature-settings: "cv11", "cv05";
		}

		@keyframes fadeInUp {
			from { opacity: 0; transform: translateY(10px); }
			to { opacity: 1; transform: translateY(0); }
		}
		
		.animate-card {
			animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		}

		select {
			background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364748b' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
			background-position: right 1rem center;
			background-repeat: no-repeat;
			background-size: 1.25em 1.25em;
		}

		/* Background Noise */
		.bg-noise {
			background-color: #0f172a; 
			background-image: 
				url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.07'/%3E%3C/svg%3E"),
				radial-gradient(circle at 50% 0%, #127289 0%, #0f172a 80%);
			background-size: 150px 150px, 100% 100%;
			background-repeat: repeat, no-repeat;
		}
	</style>

<style is:global>
/* Assistance navbar, self-contained for the directory page (dark-locked tokens) */
.assist-nav{--bg:#FDFBF7;--fg:#0A2E38;--muted:#5B6B73;--line:#E8E0D2;--accent:#127289;--accent-2:#127289;--cyan:#4DB8CC;--band:#0A2E38;--band-fg:#FDFBF7;font-family:'Inter',ui-sans-serif,system-ui,sans-serif;font-size:16px;line-height:1.55}
.assist-nav .wrap{max-width:1180px;margin:0 auto;padding-inline:20px}
.assist-nav .util{background:var(--band);color:var(--band-fg);font-size:.82rem}
.assist-nav .util .wrap{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:36px}
.assist-nav .util a{color:var(--cyan);text-decoration:none;font-weight:500}.assist-nav .util a:hover{text-decoration:underline}
.assist-nav .u-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#4CB782;margin-right:8px;box-shadow:0 0 0 3px rgba(76,183,130,.25);vertical-align:1px}
.assist-nav .nav{position:sticky;top:0;z-index:50;background:rgba(253,251,247,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.assist-nav .nav .wrap{display:flex;align-items:center;gap:26px;min-height:64px}
.assist-nav .logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--fg)}
.assist-nav .logo img{height:26px;width:auto}
.assist-nav .logo .on-light{display:block}.assist-nav .logo .on-dark{display:none}
.assist-nav .logo .tag{font-size:.78rem;color:var(--muted);border-left:1px solid var(--line);padding-left:10px;letter-spacing:.04em}
.assist-nav .nav ul{display:flex;gap:22px;list-style:none;margin:0 0 0 auto;padding:0;align-items:center}
.assist-nav .nav ul a{color:var(--fg);text-decoration:none;font-size:.92rem}
.assist-nav .nav ul a:hover{color:var(--accent)}
.assist-nav .btn{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:11px 20px;font-weight:500;font-size:.95rem;text-decoration:none;border:1px solid transparent;cursor:pointer}
.assist-nav .btn-primary{background:var(--fg);color:#fff;box-shadow:0 10px 40px -10px rgba(10,46,56,.4)}
.assist-nav .menu-btn{display:none;margin-left:auto;background:none;border:1px solid var(--line);border-radius:10px;padding:8px 12px;color:var(--fg);font:inherit}
.assist-nav .nav .mega{position:relative}
.assist-nav .nav .mega>a{display:inline-block;padding-block:22px}
.assist-nav .nav .mega>a::after{content:"";display:inline-block;margin-left:6px;border:4px solid transparent;border-top-color:currentColor;transform:translateY(2px)}
.assist-nav .nav .mm{position:absolute;left:0;right:0;top:100%;display:none}
.assist-nav .nav .mega:hover .mm,.assist-nav .nav .mega:focus-within .mm{display:block}
.assist-nav .nav .mm .wrap{display:grid;grid-template-columns:1fr 1.6fr;gap:36px;padding-block:28px 32px;align-items:start}
.assist-nav .nav .mm h6{font-weight:500;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#127289;margin:0 0 12px}
.assist-nav .mm-col{display:grid;gap:2px;align-content:start}
.assist-nav .mm-col.two{grid-template-columns:1fr 1fr;column-gap:12px}
.assist-nav .nav .mm-i{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:10px;border-radius:10px;text-decoration:none;color:#0F323D}
.assist-nav .nav .mm-i:hover{background:rgba(18,114,137,.1);color:#0F323D}
.assist-nav .mm-i b{display:block;font-weight:500;font-size:.92rem;color:#0F323D}
.assist-nav .mm-i small{display:block;color:#55707A;font-size:.78rem;line-height:1.35}
.assist-nav .ic{width:28px;height:28px;display:grid;place-items:center;color:#127289}
.assist-nav .ic svg{width:18px;height:18px}
.assist-nav .nav .mm{background:#EDF2F2;border-bottom:1px solid #C9D6D9;box-shadow:0 30px 60px -30px rgba(8,24,30,.55)}
.assist-nav .nav .mega{position:static}
.assist-nav .m-only{display:none}
@media (max-width:860px){
  .assist-nav .nav ul,.assist-nav .nav .btn{display:none}
  .assist-nav .menu-btn{display:inline-flex}
  .assist-nav .nav.open ul{display:flex;flex-direction:column;position:absolute;left:0;right:0;top:64px;background:var(--bg);padding:16px 20px;border-bottom:1px solid var(--line);gap:14px;align-items:flex-start}
  .assist-nav .m-only{display:block}
  .assist-nav .nav .mega>a{padding-block:0}
  .assist-nav .nav .mega>a::after{display:none}
  .assist-nav .nav .mm{position:static;display:block;box-shadow:none;border:0;background:none}
  .assist-nav .nav .mm .wrap{grid-template-columns:1fr;gap:14px;padding:6px 0 0 8px}
  .assist-nav .mm-col.two{grid-template-columns:1fr}
  .assist-nav .nav .mm-i,.assist-nav .mm-i b{color:var(--fg)}
  .assist-nav .mm-i small{display:none}
  .assist-nav .u-long,.assist-nav .u-desk{display:none}
}
</style>
<script is:inline>
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.assist-nav .menu-btn');
    if (!btn) return;
    var nav = btn.closest('.nav');
    nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', nav.classList.contains('open'));
  });
</script>

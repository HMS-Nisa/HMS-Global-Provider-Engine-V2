{
	// Cloudflare Workers static-assets deploy of the HMS Assistance site.
	// The HealthMetrics account owns the healthmetrics.com zone, so the
	// custom domain global.healthmetrics.com can attach directly.
	"name": "global-healthmetrics",
	"account_id": "8e292940df0e13870c713d7fe7c5eb78",
	"compatibility_date": "2026-10-01",
	// Phase 1 (host move): serve ./dist — the current Astro directory site,
	// byte-for-byte what Netlify serves today, built with the same env
	// (SITE_URL + Clarity xtd9vn6v4x).
	// Phase 2 (UI swap, after review): change this to ./site and redeploy.
	"assets": {
		"directory": "./dist"
	}
}

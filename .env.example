# Copy to .env for local overrides. Set the real values in
# Netlify -> Site configuration -> Environment variables.

# Production origin, no trailing slash. Required for canonical URL, Open Graph
# tags, robots.txt and the sitemap. When unset those are omitted entirely.
SITE_URL=https://global.healthmetrics.com

# GA4 measurement ID (G-XXXXXXXXXX). Drives sessions, users, pageviews and the
# custom directory events. Create a dedicated property - do not reuse the one
# on ocha.health.
PUBLIC_GA4_ID=

# Microsoft Clarity project ID (10-char alphanumeric, from clarity.microsoft.com).
# Heatmaps and session recordings for the filter UI.
PUBLIC_CLARITY_ID=

# Optional Google Tag Manager container (GTM-XXXXXXX). Only set this if tags are
# managed in a GTM container instead of directly above - loading GA4 both ways
# double-counts every pageview.
PUBLIC_GTM_ID=
